<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_purchase_inherit_gr" inherit_id="purchase.portal_my_purchase_orders">
        <!-- Insertar botón justo antes de la tabla de órdenes -->
        <xpath expr="//t[@t-if='orders']" position="before">
            <div class="d-flex justify-content-end mb-3 mt-2">
                <a t-attf-href="/my/gr" class="btn btn-primary">
                    📦 Portal Solicitud/Recepción (GR)
                </a>
            </div>
        </xpath>
    </template>
</odoo>
