<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cfdi_download" model="ir.ui.view">
        <field name="name">cfdi.download</field>
        <field name="model">cfdi.download.wizard</field>
        <field name="arch" type="xml">
            <form string="Parametros para descargar CFDI">
                <group >
                    <field name="starting_date"/>
                    <field name="end_date"/>
                    <field name="company_id"/>
                    <field name="rfc"/>
                </group>
                <footer>
                    <button name="download_cfdi" string="Download CFDI" type="object" class="oe_highlight" />

                    <button name="action_cancel" string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="cfdi_download_action" model="ir.actions.act_window">
        <field name="name">Descargar CFDI</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cfdi.download.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cfdi_download"></field>
        <field name="target">new</field>
    </record>

    <menuitem id="cdfi_download_menu" action="cfdi_download_action" sequence="400" parent="account.menu_finance_payables" />

</odoo>

        