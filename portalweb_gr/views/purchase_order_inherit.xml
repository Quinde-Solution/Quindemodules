<odoo>
    <record id="view_order_form_inherit_qr" model="ir.ui.view">
        <field name="name">purchase.order.form.qr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="generate_gr"/>
                <field name="code_gr"/>
                <field name="xml_validate"/>
                <field name="xml_total_sum" readonly="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="XML Cargados">
                    <field name="xml_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="total"/>
                            <!--<field name="rfc_emisor"/>-->
                            <!--<field name="total"/>-->
                            <!--<field name="validate"/>-->
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
